# Compose-only settings. Provider URL and credentials live under config/.

# Optional. Used when publishing a different host port.
# DSH_PORT=3080

# Hostname served by Nginx. Set this when using nginx/dsh.conf.example.
# DSH_TRUSTED_HOST=dsh.example.com

# Login password for the session-auth service (public access via Nginx).
# Generate one with:  openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
# Alternatively set AUTH_PASSWORD_SHA256 to a 64-char hex sha256 digest.
AUTH_PASSWORD=change-me-please

# Session lifetime in hours for the login cookie (default 24).
# Restarting the `auth` service invalidates all sessions regardless.
# AUTH_TTL_HOURS=24
