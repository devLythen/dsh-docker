# Compose-only settings. Provider URL and credentials live under config/.
# Ports are defined once here; nginx/dsh.conf.example must match (see README
# "Ports", or render with scripts/render-nginx-conf.sh).

# Host port for the DSH Web UI, published to 127.0.0.1 only. Also feeds DSH's
# trust fence automatically.
DSH_PORT=3080

# Hostname served by Nginx. Set this when using nginx/dsh.conf.example.
# DSH_TRUSTED_HOST=dsh.example.com

# Host port for the session-auth login service, published to 127.0.0.1 only.
AUTH_PORT=8081

# Optional. Host directory mounted as the agent workspace at /home/node.
# Defaults to ./workspace next to this file; uncomment to use a custom path.
# The directory must be readable/writable by uid 1000 (the container's node
# user).
# DSH_WORKSPACE=/path/to/workspace

# Login password for the session-auth service (public access via Nginx).
# Generate one with:  openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
# Alternatively set AUTH_PASSWORD_SHA256 to a 64-char hex sha256 digest.
AUTH_PASSWORD=change-me-please

# Session lifetime in hours for the login cookie (default 24).
# Restarting the `auth` service invalidates all sessions regardless.
# AUTH_TTL_HOURS=24
