# DeepSeek Harness — public reverse proxy with expiring session authentication.
#
# Every request must carry a valid dsh_session cookie; Nginx checks it with an
# internal `auth_request` subrequest against the `auth` compose service
# (127.0.0.1:8081, loopback-only). Requests without a valid cookie are
# redirected to /login/. Sessions expire after AUTH_TTL_HOURS (default 24)
# and never survive an `auth` service restart.
#
# Before reloading, set `server_name`, the TLS certificate paths, and the
# HTTPS listener (the file below starts as the plain-HTTP baseline).
# Requires nginx >= 1.5.4 with ngx_http_auth_request_module (default in
# Debian/Ubuntu packages).

server {
    listen 80;
    server_name dsh.example.com;

    # ---- Session authentication (docker-compose `auth` service) ----

    # internal auth subrequest: 200 = valid session, 401 = login required
    location = /auth {
        internal;
        proxy_pass http://127.0.0.1:8081/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # login page and session endpoints of the auth service
    location /login/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- Protected application ----

    location / {
        # Optional hardening: layer Basic Auth on top of the session cookie.
        # Create /etc/nginx/.htpasswd with `htpasswd -cB /etc/nginx/.htpasswd
        # dsh-admin`, then uncomment:
        # auth_basic "DeepSeek Harness";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        auth_request /auth;
        error_page 401 = @login;

        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;

        # The authenticated proxy is the trust boundary. DSH's privileged
        # settings and credentials APIs remain loopback-only.
        proxy_set_header Host 127.0.0.1:3080;
        proxy_set_header Origin http://127.0.0.1:3080;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # missing or expired session -> login page, then back to the deep link
    location @login {
        return 302 /login/?next=$request_uri;
    }
}
